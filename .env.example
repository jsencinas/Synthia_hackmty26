# All variables are optional.

# Enables the transcript tie-breaker (ElevenLabs Scribe). Without it the
# detector answers with timing + voice only.
ELEVENLABS_API_KEY=

# Set to 0 to disable the transcript stage even if a key is configured.
STT_ENABLED=1
# The transcript stage only runs when |p_fused - 0.5| <= this band.
STT_UNCERTAINTY_BAND=0.15
# Hard timeout for one transcription request (seconds).
STT_TIMEOUT_S=12
# Total wall-clock budget per /detect call (seconds). Judge allows 30.
REQUEST_BUDGET_S=20
